{
	// viper: a chamada já nasce com o lambda escrito. Tab passa de um campo para o próximo.
	"viper · replacement": {
		"prefix": "replacement",
		"body": "replacement(${1:lista}, '${2:palavra}', lambda x: ${3:condição})$0",
		"description": "viper: troca por 'palavra' cada item da lista em que a condição for verdadeira"
	},
	// Só a chamada, como a da replacement: o snippet entra onde o cursor estiver (depois de "x = ", de
	// "v."...), e um "a, b =" escrito por ele quebraria a linha. Que ela devolve dois lados, a leitura diz.
	"viper · compare": {
		"prefix": "compare",
		"body": "compare(${1:v1}, ${2:v2})$0",
		"description": "viper: iguala o tamanho de duas versões (completa com zeros) para comparar por fora"
	}
}
